{
  "name": "dsh-workload-report",
  "version": "2.6.0",
  "description": "DeepSeek Harness (DSH) plugin: workload, active time and token usage by date, workspace and model — calendar heatmap, model cost/speed, per-KPI sparklines, AI usage profile, multi-device sync, and 8 interface languages.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "verify": "node test/verify.mjs",
    "test": "node test/verify.mjs && node test/i18n.mjs",
    "bench:open": "node test/bench-open.mjs",
    "e2e:boot": "./test/e2e-boot.sh",
    "e2e": "node test/e2e-ui.mjs",
    "e2e:i18n": "node test/e2e-i18n.mjs",
    "check:i18n": "node test/i18n.mjs",
    "check:release": "node test/check-release.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "workload",
    "usage",
    "tokens",
    "report",
    "heatmap",
    "dashboard",
    "activity",
    "dsh-plugin",
    "deepseek",
    "usage-stats",
    "time-tracking",
    "calendar-heatmap",
    "productivity",
    "cost-tracking",
    "worklog",
    "sync",
    "multi-device",
    "cos",
    "tencent-cos",
    "object-storage",
    "token-usage",
    "usage-tracking",
    "ai-coding",
    "developer-productivity",
    "analytics",
    "ai-agent",
    "llm",
    "local-first",
    "deepseek-harness-plugin",
    "工作量报告",
    "Token 使用量",
    "トークン使用量",
    "Token-Nutzung",
    "utilisation des tokens",
    "uso de tokens",
    "использование токенов"
  ],
  "author": {
    "name": "XILEJUN",
    "url": "https://github.com/tableau-China"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tableau-China/dsh-workload-report.git"
  },
  "homepage": "https://github.com/tableau-China/dsh-workload-report#readme",
  "bugs": {
    "url": "https://github.com/tableau-China/dsh-workload-report/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-alpha.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "publishConfig": {
    "access": "public"
  }
}
