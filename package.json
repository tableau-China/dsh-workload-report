{
  "name": "dsh-workload-report",
  "version": "1.0.5",
  "description": "DeepSeek Harness (DSH) plugin — see your effort and token usage by date and workspace: calendar heatmap, time-of-day analysis, workspace share, and a shareable self-contained HTML report.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "verify": "node test/verify.mjs",
    "test": "node test/verify.mjs",
    "bench:open": "node test/bench-open.mjs",
    "e2e:boot": "./test/e2e-boot.sh",
    "e2e": "node test/e2e-ui.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "workload",
    "usage",
    "tokens",
    "report",
    "heatmap",
    "dashboard",
    "activity",
    "dsh-plugin",
    "deepseek",
    "usage-stats",
    "time-tracking",
    "calendar-heatmap",
    "productivity",
    "cost-tracking",
    "worklog"
  ],
  "author": {
    "name": "XILEJUN",
    "url": "https://github.com/tableau-China"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tableau-China/dsh-workload-report.git"
  },
  "homepage": "https://github.com/tableau-China/dsh-workload-report#readme",
  "bugs": {
    "url": "https://github.com/tableau-China/dsh-workload-report/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "publishConfig": {
    "access": "public"
  }
}
